# Совместимый короткий шаблон.
# Канонический production template: .env.example
# Скопировать: cp .env.example .env
# Секреты не коммитить.

FLASK_ENV=production
FLASK_CONFIG=production
SECRET_KEY=

DOMAIN=mywavewake.ru
BASE_URL=https://mywavewake.ru
PUBLIC_BASE_URL=https://mywavewake.ru
SITE_BASE_URL=https://mywavewake.ru
SERVER_NAME=mywavewake.ru
HEALTHCHECK_URL=https://mywavewake.ru/health

DATABASE_URL=sqlite:////var/www/mywave/instance/mywave.db

OPENAI_API_KEY=
ASSISTANT_ID=
CHAT_BACKEND=completions
# OPENAI_HTTP_PROXY=http://user:pass@host:port
GPTS_MODEL=gpt-4.1-nano
FALLBACK_MODEL=gpt-4.1-nano

# Google
# Admin/Tg Bot — бронь, клиенты, каталог (НЕ блог)
SPREADSHEET_ID=
# Parser News — витрина блога, лист raw_feed (отдельно от SPREADSHEET_ID)
PARSER_NEWS_SPREADSHEET_ID=1RJpw2mAMej3a-VC6yKAsKkVQvzGStcjUC7LijNNyn50
PARSER_SHEET_NAME=raw_feed
# Бегущая строка соревнований на главной (лист в той же таблице Parser News)
COMPETITIONS_SHEET_NAME=competitions_ticker
COMPETITIONS_SHEETS_CACHE_TTL=300
# Опционально: отдельный токен invalidate для Parser (если пусто — используется MEDIA_UPLOAD_TOKEN)
# COMPETITIONS_CACHE_INVALIDATE_TOKEN=
# Альтернатива: PARSER_TAB=<spreadsheet_id> или PARSER_TAB=raw_feed внутри SPREADSHEET_ID
GOOGLE_CALENDAR_ID=
ENABLE_GOOGLE_SERVICES=1
# путь к JSON учётки на сервере
GOOGLE_SERVICE_ACCOUNT_FILE=/var/www/mywave/instance/service_account.json
GOOGLE_SHEETS_CREDENTIALS=/var/www/mywave/instance/service_account.json
GOOGLE_APPLICATION_CREDENTIALS=/var/www/mywave/instance/service_account.json
DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_ID=

# Redis (production)
REDIS_URL=redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
SOCKETIO_MESSAGE_QUEUE=redis://127.0.0.1:6379/0
GUNICORN_BIND=127.0.0.1:5000
GUNICORN_WORKERS=1
GUNICORN_WORKER_CLASS=eventlet
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30

# Telegram (сайт / webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_CHAT_ID=510686579
# SAFARI_SPREADSHEET_ID=   # если пусто — используется SPREADSHEET_ID
TRAINER_CHAT_ID=
NOTIFICATION_BOT_TOKEN=

# WakeSurf Challenge 2025 (если отдельная таблица — иначе используется SPREADSHEET_ID)
# WSC2025_SPREADSHEET_ID=
WSC_ADMIN_EMAIL=y.valeev@gmail.com

# SMTP для писем о заявках WSC (опционально; Telegram работает без этого)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=noreply@mywavewake.ru
WEBHOOK_URL=https://mywavewake.ru

# Отдельный control bot (telegram_bot.py)
TG_CONTROL_BOT_TOKEN=
TG_CONTROL_ALLOWED_IDS=
MW_REPO_PATH=/var/www/mywave

# Healthcheck / алерт (scripts/healthcheck.sh)
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Grafana (docker compose)
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=changeme

# Rate limit (prod)
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0

# MyWave Social Mission (default OFF on production)
# SOCIAL_MODULE_ENABLED=0
# SOCIAL_WIDGET_ENABLED=0
# SOCIAL_APPLICATIONS_ENABLED=0
# SOCIAL_PUBLIC_STATS_ENABLED=0
# SOCIAL_ADMIN_NOTIFICATIONS_ENABLED=0
# SOCIAL_SPREADSHEET_ID=   # if empty — uses SPREADSHEET_ID (Admin sheet)
# SOCIAL_APPLICATIONS_SHEET_NAME=Social_Applications

# Events track (default OFF until Events-2+ wiring)
# EVENTS_CLASSIFIER_ENABLED=0
# EVENTS_API_ENABLED=0
# EVENTS_REVIEW_API_ENABLED=0
# EVENTS_SHEETS_CACHE_TTL=300
