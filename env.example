# Совместимый короткий шаблон.
# Канонический production template: .env.example
# Скопировать: cp .env.example .env
# Секреты не коммитить.

FLASK_ENV=production
FLASK_CONFIG=production
SECRET_KEY=

DOMAIN=mywavewake.ru
BASE_URL=https://mywavewake.ru
PUBLIC_BASE_URL=https://mywavewake.ru
SITE_BASE_URL=https://mywavewake.ru
SERVER_NAME=mywavewake.ru
HEALTHCHECK_URL=https://mywavewake.ru/health

DATABASE_URL=sqlite:////var/www/mywave/instance/mywave.db

OPENAI_API_KEY=
ASSISTANT_ID=
CHAT_BACKEND=completions
# OPENAI_HTTP_PROXY=http://user:pass@host:port
GPTS_MODEL=gpt-4.1-nano
FALLBACK_MODEL=gpt-4.1-nano

# Google Sheets — две таблицы, не путать (канон: docs/integration/SHEETS_ID_CANON.md)
#
# Admin / Tg Bot — бронь, клиенты, Social_Applications (tail …akVMOrCgic0)
SPREADSHEET_ID=
#
# Parser News — блог raw_feed, competitions ticker (tail …LijNNyn50)
# НЕ подставлять в SPREADSHEET_ID — только в PARSER_NEWS_SPREADSHEET_ID
PARSER_NEWS_SPREADSHEET_ID=
PARSER_SHEET_NAME=raw_feed
# Бегущая строка соревнований на главной (лист в той же таблице Parser News)
COMPETITIONS_SHEET_NAME=competitions_ticker
COMPETITIONS_SHEETS_CACHE_TTL=300
# Опционально: отдельный токен invalidate для Parser (если пусто — используется MEDIA_UPLOAD_TOKEN)
# COMPETITIONS_CACHE_INVALIDATE_TOKEN=
# Альтернатива: PARSER_TAB=<spreadsheet_id> или PARSER_TAB=raw_feed внутри SPREADSHEET_ID
GOOGLE_CALENDAR_ID=
ENABLE_GOOGLE_SERVICES=1
# путь к JSON учётки на сервере
GOOGLE_SERVICE_ACCOUNT_FILE=/var/www/mywave/instance/service_account.json
GOOGLE_SHEETS_CREDENTIALS=/var/www/mywave/instance/service_account.json
GOOGLE_APPLICATION_CREDENTIALS=/var/www/mywave/instance/service_account.json
DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_ID=

# Redis (production)
REDIS_URL=redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
SOCKETIO_MESSAGE_QUEUE=redis://127.0.0.1:6379/0
GUNICORN_BIND=127.0.0.1:5000
GUNICORN_WORKERS=1
GUNICORN_WORKER_CLASS=eventlet
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30

# Telegram (сайт / webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_CHAT_ID=510686579
# SAFARI_SPREADSHEET_ID=   # если пусто — используется SPREADSHEET_ID
TRAINER_CHAT_ID=
NOTIFICATION_BOT_TOKEN=

# Product leads (PR53) — вкладка в SPREADSHEET_ID
# PRODUCT_LEADS_SHEET_NAME=Product_Leads

# WakeSurf Challenge 2025 (если отдельная таблица — иначе используется SPREADSHEET_ID)
# WSC2025_SPREADSHEET_ID=
WSC_ADMIN_EMAIL=y.valeev@gmail.com

# SMTP для писем о заявках WSC (опционально; Telegram работает без этого)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=noreply@mywavewake.ru
WEBHOOK_URL=https://mywavewake.ru

# Отдельный control bot (telegram_bot.py)
TG_CONTROL_BOT_TOKEN=
TG_CONTROL_ALLOWED_IDS=
MW_REPO_PATH=/var/www/mywave

# Healthcheck / алерт (scripts/healthcheck.sh)
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Grafana (docker compose)
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=changeme

# Rate limit (prod)
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0

# MyWave Social Mission (default OFF on production)
# SOCIAL_MODULE_ENABLED=0
# SOCIAL_WIDGET_ENABLED=0
# SOCIAL_APPLICATIONS_ENABLED=0
# SOCIAL_PUBLIC_STATS_ENABLED=0
# SOCIAL_ADMIN_NOTIFICATIONS_ENABLED=0
# SOCIAL_BOOKING_ENABLED=0
# SOCIAL_SPREADSHEET_ID=   # tail …akVMOrCgic0 (Admin); if empty — uses SPREADSHEET_ID
# SOCIAL_APPLICATIONS_SHEET_NAME=Social_Applications

# MyWave Online Coaching (default OFF on production)
# ONLINE_COACHING_ENABLED=0
# ONLINE_COACHING_APPLICATIONS_ENABLED=0
# ONLINE_COACHING_ADMIN_ENABLED=0
# ONLINE_COACHING_NOTIFICATIONS_ENABLED=0
# Phase 2 (default OFF)
# ONLINE_COACHING_TBANK_API_ENABLED=0
# ONLINE_COACHING_REMINDERS_ENABLED=0
# ONLINE_COACHING_TELEGRAM_VIDEO_UPLOAD_ENABLED=0
# ONLINE_COACHING_CHANNEL_NOTIFY_ENABLED=0
# TBANK_TERMINAL_KEY=
# TBANK_SECRET_KEY=
# TBANK_API_URL=https://securepay.tinkoff.ru/v2
# TBANK_NOTIFICATION_URL=https://mywavewake.ru/api/online-coaching/tbank/webhook
# TELEGRAM_WEBHOOK_SECRET=
# ONLINE_COACHING_TELEGRAM_WEBHOOK_SECRET=
# MAX_API_URL=
# MAX_API_TOKEN=
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
# ONLINE_REQUESTS_SHEET_NAME=Online_Requests
# ONLINE_DIARIES_SHEET_NAME=Online_Diaries
# ONLINE_PAYMENTS_SHEET_NAME=Online_Payments
# ONLINE_FOLLOWUPS_SHEET_NAME=Online_Followups
# ONLINE_REVIEWS_SHEET_NAME=Online_Reviews
# MEDIA_FILES_SHEET_NAME=Media_Files

# Projects / Camp catalog (default OFF — enable only after migration + Tour feed contract)
# CAMP_MODULE_ENABLED=0
# CAMP_PUBLIC_ENABLED=0
# CAMP_ADMIN_ENABLED=0
# CAMP_IMPORT_ENABLED=0
# MYWAVE_TOUR_CAMPS_FEED_URL=https://api.mywavetour.ru/camps-feed.json
# MYWAVE_TOUR_CAMPS_API_URL=https://api.mywavetour.ru/camps
# MYWAVE_TOUR_CAMP_API_TOKEN=
# MYWAVE_TOUR_USE_API_PAGINATION=0
