# MyWave Safari Application - Docker Environment Configuration
# Use this file for docker-compose development/staging environments

# === Flask Configuration ===
FLASK_ENV=production
FLASK_APP=main.py
SECRET_KEY=your_very_secret_key_change_in_production_123456789

# === Database Configuration ===
# PostgreSQL
POSTGRES_USER=mywave_user
POSTGRES_PASSWORD=secure_password_123
POSTGRES_DB=mywave_safari
DATABASE_URL=postgresql://mywave_user:secure_password_123@db:5432/mywave_safari

# === Redis Configuration ===
REDIS_URL=redis://redis:6379/0
SOCKETIO_MESSAGE_QUEUE=redis://redis:6379/1

# === Google Services Configuration ===
# Google Sheets API for Analytics
ANALYTICS_SHEET_SPREADSHEET_ID=your_google_sheets_id_here

# Google Calendar Integration
GOOGLE_CALENDAR_ID=your_google_calendar_id_here

# Service Account JSON path (mounted from ./instance volume)
GOOGLE_SERVICE_ACCOUNT_FILE=/app/instance/service_account.json

# === OpenAI Configuration ===
# For AI chat features
OPENAI_API_KEY=sk-your_openai_api_key_here
ASSISTANT_ID=asst_your_assistant_id_here

# === Payment Configuration ===
# YooKassa Test Merchant
YOOKASSA_SHOP_ID=your_yookassa_shop_id
YOOKASSA_API_KEY=your_yookassa_api_key
YOOKASSA_WEBHOOK_SECRET=your_webhook_secret

# === Email Configuration ===
# SMTP for sending notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=noreply@mywave.com

# === SMS Configuration (optional) ===
# For SMS notifications
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE=+1234567890

# === Telegram Bot (optional) ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === Logging & Monitoring ===
# Application logs
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# === Security ===
# CORS allowed origins
CORS_ORIGINS=http://localhost:3000,https://mywave.com
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# === Application Settings ===
# Admin email
ADMIN_EMAIL=admin@mywave.com

# Site name
SITE_NAME=MyWave Safari

# Max upload file size (in MB)
MAX_UPLOAD_SIZE=50

# Booking settings
MAX_DAYS_BOOKING=30
MIN_ADVANCE_BOOKING_HOURS=24

# === Performance ===
# Cache settings
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://redis:6379/2

# Query optimization
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# === Debug Mode (set to false for production) ===
DEBUG=false

# === Docker-Specific Settings ===
# Gunicorn workers
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=gevent
GUNICORN_TIMEOUT=120

# Application binding
APP_HOST=0.0.0.0
APP_PORT=5000
