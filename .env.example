# ============================================================

# MyWaveWake Site — production template for Timeweb

# Скопируйте в .env и заполните реальные значения только на сервере

# ============================================================



# --- Обязательные (production) ---

SECRET_KEY=replace-with-random-secret-min-16-chars

FLASK_DEBUG=False

FLASK_ENV=production

FLASK_CONFIG=production



# --- Домен / публичные URL ---

DOMAIN=mywavewake.ru

BASE_URL=https://mywavewake.ru

PUBLIC_BASE_URL=https://mywavewake.ru

SITE_BASE_URL=https://mywavewake.ru

SERVER_NAME=mywavewake.ru

HEALTHCHECK_URL=https://mywavewake.ru/health



# --- База данных ---

DATABASE_URL=sqlite:////var/www/mywave/instance/mywave.db



# --- Google API (бронирование, календарь, Sheets, блог) ---

ENABLE_GOOGLE_SERVICES=true

GOOGLE_SERVICE_ACCOUNT_FILE=/var/www/mywave/instance/service_account.json

GOOGLE_SHEETS_CREDENTIALS=/var/www/mywave/instance/service_account.json

GOOGLE_APPLICATION_CREDENTIALS=/var/www/mywave/instance/service_account.json

SPREADSHEET_ID=

GOOGLE_SHEET_ID=

GOOGLE_CALENDAR_ID=

DRIVE_FOLDER_ID=

GOOGLE_DRIVE_FOLDER_ID=

GOOGLE_SHEET_NAME=Responses



# --- Блог / Parser (raw_feed) ---

# BLOG_SHEETS_CACHE_TTL=120

# BLOG_DEBUG_EXCERPT_TRACE=0



# --- OpenAI (AI-чат) ---

OPENAI_API_KEY=sk-replace-me

ASSISTANT_ID=

CHAT_BACKEND=auto

# Только имена моделей, не API key

GPTS_MODEL=gpt-4.1-mini

FALLBACK_MODEL=gpt-4.1-mini



# --- Redis (production, localhost only) ---

REDIS_URL=redis://127.0.0.1:6379/0

RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0

SOCKETIO_MESSAGE_QUEUE=redis://127.0.0.1:6379/0



# --- Telegram ---

TELEGRAM_BOT_TOKEN=

TELEGRAM_CHAT_ID=

WEBHOOK_URL=https://mywavewake.ru

NOTIFICATION_BOT_TOKEN=

TRAINER_CHAT_ID=

TG_CONTROL_BOT_TOKEN=

TG_CONTROL_ALLOWED_IDS=

MW_REPO_PATH=/var/www/mywave



# --- Аналитика ---

ANALYTICS_SHEET_SPREADSHEET_ID=

ANALYTICS_SHEET_NAME=analytics_statistics

ENABLE_ANALYTICS=True

ENABLE_RECOMMENDATIONS=True



# --- Админка ---

ADMIN_USERNAME=

ADMIN_PASSWORD=



# --- Gunicorn / Socket.IO ---

GUNICORN_BIND=127.0.0.1:5000

GUNICORN_WORKERS=1

GUNICORN_WORKER_CLASS=eventlet

GUNICORN_TIMEOUT=120

GUNICORN_GRACEFUL_TIMEOUT=30



# --- Monitoring / healthcheck ---

SENTRY_DSN=

PROMETHEUS_MULTIPROC_DIR=/var/www/mywave/prometheus_multiproc

ENABLE_AI_HEALTH_CHECK=False

ALERT_TELEGRAM_BOT_TOKEN=

ALERT_TELEGRAM_CHAT_ID=


