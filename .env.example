# ============================================================
# MyWave Site — переменные окружения (пример)
# Скопируйте в .env и заполните значения
# ============================================================

# --- Обязательные (production) ---
SECRET_KEY=replace-with-random-secret-min-16-chars
FLASK_DEBUG=False
FLASK_ENV=production

# --- База данных ---
# Development
DEV_DATABASE_URL=sqlite:///dev-app.db
# Production (PostgreSQL в Docker)
DATABASE_URL=postgresql://user:password@localhost:5432/mywave_safari

# --- Google API (бронирование, календарь, Sheets) ---
GOOGLE_SERVICE_ACCOUNT_FILE=configs/service_account.json
# или путь к JSON сервисного аккаунта:
# GOOGLE_SHEETS_CREDENTIALS=/path/to/credentials.json
SPREADSHEET_ID=
GOOGLE_CALENDAR_ID=
GOOGLE_SHEET_NAME=Responses

# --- OpenAI (AI-чат) ---
OPENAI_API_KEY=
ASSISTANT_ID=
GPTS_MODEL=gpt-4
FALLBACK_MODEL=gpt-3.5-turbo

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=https://your-domain.com
NOTIFICATION_BOT_TOKEN=
TRAINER_CHAT_ID=

# --- Аналитика ---
ANALYTICS_SHEET_SPREADSHEET_ID=
ANALYTICS_SHEET_NAME=analytics_statistics
ENABLE_ANALYTICS=True
ENABLE_RECOMMENDATIONS=True

# --- Админка (admin_panel, если зарегистрирован) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- AI Gateway / Concierge ---
AI_GATEWAY_API_KEYS=
AI_GATEWAY_REQUIRE_API_KEY=False
ADMIN_TOKEN=

# --- Мониторинг ---
SENTRY_DSN=
PROMETHEUS_MULTIPROC_DIR=./prometheus_multiproc
ENABLE_AI_HEALTH_CHECK=False

# --- Docker (опционально) ---
POSTGRES_USER=mywave_user
POSTGRES_PASSWORD=replace-with-secure-password
POSTGRES_DB=mywave_safari
REDIS_URL=redis://redis:6379/0
