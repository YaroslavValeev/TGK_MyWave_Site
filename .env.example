# ============================================================
# MyWaveWake Site — production template for Timeweb
# Скопируйте в .env и заполните реальные значения только на сервере
# ============================================================

# --- Обязательные (production) ---
SECRET_KEY=replace-with-random-secret-min-16-chars
FLASK_DEBUG=False
FLASK_ENV=production
FLASK_CONFIG=production

# --- Домен / публичные URL ---
DOMAIN=mywavewake.ru
BASE_URL=https://mywavewake.ru
PUBLIC_BASE_URL=https://mywavewake.ru
SITE_BASE_URL=https://mywavewake.ru
SERVER_NAME=mywavewake.ru
HEALTHCHECK_URL=https://mywavewake.ru/health

# --- База данных ---
# Development
DEV_DATABASE_URL=sqlite:///dev-app.db
# Production (SQLite на сервере)
DATABASE_URL=sqlite:////var/www/mywave/instance/mywave.db

# --- Google API (бронирование, календарь, Sheets) ---
ENABLE_GOOGLE_SERVICES=True
GOOGLE_SERVICE_ACCOUNT_FILE=/var/www/mywave/instance/service_account.json
# Legacy alias для совместимости со старыми скриптами:
# GOOGLE_SHEETS_CREDENTIALS=/var/www/mywave/instance/service_account.json
SPREADSHEET_ID=
GOOGLE_CALENDAR_ID=
GOOGLE_SHEET_NAME=Responses

# --- Блог / Parser (raw_feed) ---
# TTL кэша списка постов из Sheets (секунды)
# BLOG_SHEETS_CACHE_TTL=120
# Диагностика карточек: в лог (INFO) для каждой publishable-строки — slug, excerpt/summary/lead/final_posts (усечено), итоговый excerpt
# BLOG_DEBUG_EXCERPT_TRACE=1

# --- OpenAI (AI-чат) ---
# Только API key, не имя модели
OPENAI_API_KEY=
ASSISTANT_ID=
# auto | completions | responses | assistant_only — см. docs/CHAT_RUNTIME_AND_RELEASE.md
CHAT_BACKEND=auto
# 1 — дублировать успешные ответы Assistant в Google Sheets (как у Chat Completions); 0 — не писать
# CHAT_SHEETS_LOG_ASSISTANT=1
# Рекомендуемый rollout:
# - completions: текущий стабильный rollback
# - responses: первая итерация миграции публичного text chat на OpenAI Responses API
# Важно: не путать с gpt-4.1-min (без «i») — это неверное имя; при опечатке код поправит на gpt-4.1-mini и залогирует предупреждение.
# Только имена моделей, не API key
GPTS_MODEL=gpt-4.1-nano
FALLBACK_MODEL=gpt-4.1-nano

# Flask-Limiter: локально memory://; при включении Redis — redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=memory://

# Логи: на Windows по умолчанию без ротации (избежать WinError 32). На Linux — суточная ротация.
# LOG_USE_TIMED_ROTATION=0 — принудительно без ротации; =1 — с ротацией (осторожно на Windows).
# LOG_USE_TIMED_ROTATION=

# --- Telegram ---
# DISABLE_TELEGRAM=1 — отключить бота (для локального запуска при конфликтах eventlet/SSL)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=https://mywavewake.ru
NOTIFICATION_BOT_TOKEN=
TRAINER_CHAT_ID=
TG_CONTROL_BOT_TOKEN=
TG_CONTROL_ALLOWED_IDS=
MW_REPO_PATH=/var/www/mywave

# --- Аналитика ---
ANALYTICS_SHEET_SPREADSHEET_ID=
ANALYTICS_SHEET_NAME=analytics_statistics
ENABLE_ANALYTICS=True
ENABLE_RECOMMENDATIONS=True

# --- Админка (admin_panel, если зарегистрирован) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- AI Gateway / Concierge ---
AI_GATEWAY_API_KEYS=
AI_GATEWAY_REQUIRE_API_KEY=False
ADMIN_TOKEN=

# --- Gunicorn / Socket.IO ---
GUNICORN_BIND=127.0.0.1:5000
GUNICORN_WORKERS=1
GUNICORN_WORKER_CLASS=eventlet
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
# При необходимости масштабирования Socket.IO:
# SOCKETIO_MESSAGE_QUEUE=redis://127.0.0.1:6379/0

# --- Monitoring / healthcheck ---
SENTRY_DSN=
PROMETHEUS_MULTIPROC_DIR=./prometheus_multiproc
ENABLE_AI_HEALTH_CHECK=False
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- Redis (опционально, только localhost) ---
# REDIS_URL=redis://127.0.0.1:6379/0
