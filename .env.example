# ============================================================
# MyWave Site — переменные окружения (пример)
# Скопируйте в .env и заполните значения
# ============================================================

# --- Обязательные (production) ---
SECRET_KEY=replace-with-random-secret-min-16-chars
FLASK_DEBUG=False
FLASK_ENV=production

# --- База данных ---
# Development
DEV_DATABASE_URL=sqlite:///dev-app.db
# Production (PostgreSQL в Docker)
DATABASE_URL=postgresql://user:password@localhost:5432/mywave_safari

# --- Google API (бронирование, календарь, Sheets) ---
GOOGLE_SERVICE_ACCOUNT_FILE=configs/service_account.json
# или путь к JSON сервисного аккаунта:
# GOOGLE_SHEETS_CREDENTIALS=/path/to/credentials.json
SPREADSHEET_ID=
GOOGLE_CALENDAR_ID=
GOOGLE_SHEET_NAME=Responses

# --- Блог / Parser (raw_feed) ---
# TTL кэша списка постов из Sheets (секунды)
# BLOG_SHEETS_CACHE_TTL=120
# Диагностика карточек: в лог (INFO) для каждой publishable-строки — slug, excerpt/summary/lead/final_posts (усечено), итоговый excerpt
# BLOG_DEBUG_EXCERPT_TRACE=1

# --- OpenAI (AI-чат) ---
OPENAI_API_KEY=
ASSISTANT_ID=
# auto | completions | responses | assistant_only — см. docs/CHAT_RUNTIME_AND_RELEASE.md
CHAT_BACKEND=auto
# 1 — дублировать успешные ответы Assistant в Google Sheets (как у Chat Completions); 0 — не писать
# CHAT_SHEETS_LOG_ASSISTANT=1
# Рекомендуемый rollout:
# - completions: текущий стабильный rollback
# - responses: первая итерация миграции публичного text chat на OpenAI Responses API
# Важно: не путать с gpt-4.1-min (без «i») — это неверное имя; при опечатке код поправит на gpt-4.1-mini и залогирует предупреждение.
GPTS_MODEL=gpt-4.1-nano
FALLBACK_MODEL=gpt-4.1-nano

# Flask-Limiter: локально memory://; в production — redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=memory://

# Логи: на Windows по умолчанию без ротации (избежать WinError 32). На Linux — суточная ротация.
# LOG_USE_TIMED_ROTATION=0 — принудительно без ротации; =1 — с ротацией (осторожно на Windows).
# LOG_USE_TIMED_ROTATION=

# --- Telegram ---
# DISABLE_TELEGRAM=1 — отключить бота (для локального запуска при конфликтах eventlet/SSL)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=https://your-domain.com
NOTIFICATION_BOT_TOKEN=
TRAINER_CHAT_ID=

# --- Аналитика ---
ANALYTICS_SHEET_SPREADSHEET_ID=
ANALYTICS_SHEET_NAME=analytics_statistics
ENABLE_ANALYTICS=True
ENABLE_RECOMMENDATIONS=True

# --- Админка (admin_panel, если зарегистрирован) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- AI Gateway / Concierge ---
AI_GATEWAY_API_KEYS=
AI_GATEWAY_REQUIRE_API_KEY=False
ADMIN_TOKEN=

# --- Мониторинг ---
SENTRY_DSN=
PROMETHEUS_MULTIPROC_DIR=./prometheus_multiproc
ENABLE_AI_HEALTH_CHECK=False

# --- Docker (опционально) ---
POSTGRES_USER=mywave_user
POSTGRES_PASSWORD=replace-with-secure-password
POSTGRES_DB=mywave_safari
REDIS_URL=redis://redis:6379/0
