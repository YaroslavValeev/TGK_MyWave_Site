+@api_bp.route('/lead', methods=['POST'])
+def api_lead():
+    """
+    POST /api/lead тАФ ╨┐╤А╨╕╤С╨╝ ╨╗╨╕╨┤-╨╖╨░╤П╨▓╨╛╨║ (╨в╤А╨╡╨╜╨╡╤А ╨╜╨░ ╨▓╤Л╨╡╨╖╨┤╨╡, ╨Ъ╨╛╨╜╤Б╨░╨╗╤В╨╕╨╜╨│).
