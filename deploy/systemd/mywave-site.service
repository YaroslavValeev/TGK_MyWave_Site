[Unit]
Description=MyWave Gunicorn (Flask + Socket.IO)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/mywave
EnvironmentFile=-/var/www/mywave/.env
ExecStart=/var/www/mywave/venv/bin/gunicorn -c gunicorn.conf.py main:app
Restart=always
RestartSec=5
TimeoutStopSec=150

# Логи
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mywave-site

# Безопасность (раскомментировать при готовности)
# NoNewPrivileges=true
# PrivateTmp=true

[Install]
WantedBy=multi-user.target
